#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
DEFAULT_BIN="$REPO_ROOT/target/debug/kumu"

die() {
  echo "kumu-verify: $*" >&2
  exit 1
}

run_dir_for() {
  local run_id="$1"
  [[ -n "$run_id" ]] || die "run-id is required"
  echo "/tmp/kumu-verify-${run_id}"
}

load_meta() {
  local run_id="$1"
  local rdir
  rdir="$(run_dir_for "$run_id")"
  local meta="$rdir/meta.env"
  [[ -f "$meta" ]] || die "no run metadata at $meta (run launch first)"
  # shellcheck disable=SC1090
  source "$meta"
}

cmd_launch() {
  local run_id="run-$(date +%Y%m%d-%H%M%S)-$$"
  local project_dir="$REPO_ROOT"
  local bin_path="$DEFAULT_BIN"
  local timeout_secs=20

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run-id)
        run_id="${2:-}"
        shift 2
        ;;
      --project)
        project_dir="${2:-}"
        shift 2
        ;;
      --bin)
        bin_path="${2:-}"
        shift 2
        ;;
      --timeout)
        timeout_secs="${2:-20}"
        shift 2
        ;;
      *)
        die "unknown launch option: $1"
        ;;
    esac
  done

  [[ -x "$bin_path" ]] || die "binary not found or not executable: $bin_path (run cargo build first)"
  [[ -d "$project_dir" ]] || die "project directory does not exist: $project_dir"

  local rdir edir home_dir sock_path db_path log_path pid_file meta_file
  rdir="$(run_dir_for "$run_id")"
  edir="/tmp/kumu-verify-evidence/${run_id}"
  home_dir="$rdir/home"
  sock_path="$home_dir/.kumu/control.sock"
  db_path="$home_dir/.kumu/kumu.db"
  log_path="$rdir/kumu.log"
  pid_file="$rdir/pid"
  meta_file="$rdir/meta.env"

  if [[ -f "$pid_file" ]]; then
    local existing_pid
    existing_pid="$(cat "$pid_file")"
    if kill -0 "$existing_pid" 2>/dev/null; then
      die "run '$run_id' is already running (pid $existing_pid); clean it up or choose another --run-id"
    fi
  fi

  mkdir -p "$home_dir" "$edir"

  (
    cd "$project_dir"
    exec env \
      -u KUMU_APP_PID \
      -u KUMU_PANE \
      -u KUMU_APP_BINARY \
      -u KUMU_CONTROL_SOCKET \
      -u KUMU_TTY \
      -u KUMU_TERMINAL \
      -u KUMU_SESSION_TOKEN \
      HOME="$home_dir" \
      KUMU_CONTROL_SOCKET="$sock_path" \
      KUMU_LOG_TO_FILE=0 \
      "$bin_path" >"$log_path" 2>&1
  ) &
  local pid=$!
  echo "$pid" >"$pid_file"

  cat >"$meta_file" <<EOF
RUN_ID=$(printf '%q' "$run_id")
KUMU_PID=$(printf '%q' "$pid")
KUMU_BIN=$(printf '%q' "$bin_path")
RUN_HOME=$(printf '%q' "$home_dir")
RUN_SOCK=$(printf '%q' "$sock_path")
RUN_DB=$(printf '%q' "$db_path")
RUN_LOG=$(printf '%q' "$log_path")
PROJECT_DIR=$(printf '%q' "$project_dir")
EVIDENCE_DIR=$(printf '%q' "$edir")
EOF

  local deadline=$((SECONDS + timeout_secs))
  local panes_json=""
  while (( SECONDS < deadline )); do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "kumu-verify: process $pid exited before becoming ready. Log:" >&2
      cat "$log_path" >&2 || true
      exit 1
    fi
    if [[ -S "$sock_path" ]]; then
      if panes_json="$(env \
        -u KUMU_PANE \
        -u KUMU_APP_BINARY \
        -u KUMU_TTY \
        -u KUMU_TERMINAL \
        -u KUMU_SESSION_TOKEN \
        HOME="$home_dir" \
        KUMU_CONTROL_SOCKET="$sock_path" \
        KUMU_APP_PID="$pid" \
        "$bin_path" panes --json 2>/dev/null)"; then
        if python3 -c 'import json,sys; d=json.loads(sys.argv[1]); sys.exit(0 if any(not p.get("exited", True) for p in d) else 1)' "$panes_json" 2>/dev/null; then
          echo "RUN_ID=$run_id"
          echo "PID=$pid"
          echo "HOME=$home_dir"
          echo "SOCKET=$sock_path"
          echo "DB=$db_path"
          echo "LOG=$log_path"
          echo "EVIDENCE_DIR=$edir"
          return 0
        fi
      fi
    fi
    sleep 0.25
  done

  echo "kumu-verify: timed out after ${timeout_secs}s waiting for Kumu (pid $pid) to open a live pane. Log:" >&2
  cat "$log_path" >&2 || true
  exit 1
}

cmd_doctor() {
  local run_id="${1:-}"
  load_meta "$run_id"

  local ok=1
  if kill -0 "$KUMU_PID" 2>/dev/null; then
    echo "process: ok (pid $KUMU_PID)"
  else
    echo "process: FAIL (pid $KUMU_PID is not running)" >&2
    ok=0
  fi

  if [[ -x "$KUMU_BIN" ]]; then
    local mtime
    mtime="$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$KUMU_BIN" 2>/dev/null || echo unknown)"
    echo "binary: ok ($KUMU_BIN, built $mtime)"
  else
    echo "binary: FAIL ($KUMU_BIN missing)" >&2
    ok=0
  fi

  if [[ -f "$RUN_DB" ]]; then
    echo "db: ok ($RUN_DB)"
  else
    echo "db: FAIL ($RUN_DB missing)" >&2
    ok=0
  fi

  if [[ -S "$RUN_SOCK" ]]; then
    echo "socket: ok ($RUN_SOCK)"
  else
    echo "socket: FAIL ($RUN_SOCK missing)" >&2
    ok=0
  fi

  local panes_json=""
  if panes_json="$(env \
    -u KUMU_PANE \
    -u KUMU_APP_BINARY \
    -u KUMU_TTY \
    -u KUMU_TERMINAL \
    -u KUMU_SESSION_TOKEN \
    HOME="$RUN_HOME" \
    KUMU_CONTROL_SOCKET="$RUN_SOCK" \
    KUMU_APP_PID="$KUMU_PID" \
    "$KUMU_BIN" panes --json 2>&1)"; then
    local summary
    summary="$(python3 -c 'import json,sys; d=json.loads(sys.argv[1]); live=[p for p in d if not p.get("exited")]; focused=[p["id"] for p in d if p.get("focused")]; print(f"{len(live)}/{len(d)} live panes, focused={focused}")' "$panes_json")"
    echo "control: ok ($summary)"
  else
    echo "control: FAIL ($panes_json)" >&2
    ok=0
  fi

  echo "evidence_dir: $EVIDENCE_DIR"
  [[ "$ok" -eq 1 ]]
}

cmd_cli() {
  local run_id="${1:-}"
  shift || true
  [[ "${1:-}" == "--" ]] && shift
  [[ $# -gt 0 ]] || die "usage: kumu-verify cli <run-id> -- <kumu args...>"
  load_meta "$run_id"

  exec env \
    -u KUMU_PANE \
    -u KUMU_APP_BINARY \
    -u KUMU_TTY \
    -u KUMU_TERMINAL \
    -u KUMU_SESSION_TOKEN \
    HOME="$RUN_HOME" \
    KUMU_CONTROL_SOCKET="$RUN_SOCK" \
    KUMU_APP_PID="$KUMU_PID" \
    "$KUMU_BIN" "$@"
}

cmd_db() {
  local run_id="${1:-}"
  local sql="${2:-}"
  [[ -n "$sql" ]] || die "usage: kumu-verify db <run-id> \"<sql>\""
  load_meta "$run_id"
  [[ -f "$RUN_DB" ]] || die "database not found at $RUN_DB"
  exec sqlite3 -readonly -header -column "$RUN_DB" "$sql"
}

cmd_screenshot() {
  local run_id="${1:-}"
  local out_path="${2:-}"
  [[ -n "$out_path" ]] || die "usage: kumu-verify screenshot <run-id> <output-png>"
  load_meta "$run_id"
  mkdir -p "$(dirname "$out_path")"
  screencapture -x "$out_path"
  echo "saved screenshot: $out_path"
}

cmd_cleanup() {
  local run_id="${1:-}"
  local rdir
  rdir="$(run_dir_for "$run_id")"
  local pid_file="$rdir/pid"

  if [[ -f "$pid_file" ]]; then
    local pid
    pid="$(cat "$pid_file")"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
      for _ in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.25
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    fi
  fi

  if [[ -d "$rdir" ]]; then
    rm -rf "$rdir"
  fi
  echo "cleaned up run '$run_id' (evidence preserved under /tmp/kumu-verify-evidence/${run_id})"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    cli) cmd_cli "$@" ;;
    db) cmd_db "$@" ;;
    screenshot) cmd_screenshot "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    -h|--help|"")
      cat <<'EOF'
usage:
  kumu-verify launch [--run-id <id>] [--project <dir>] [--bin <path>] [--timeout <secs>]
  kumu-verify doctor <run-id>
  kumu-verify cli <run-id> -- <kumu args...>
  kumu-verify db <run-id> "<sql>"
  kumu-verify screenshot <run-id> <output-png>
  kumu-verify cleanup <run-id>
EOF
      ;;
    *)
      die "unknown subcommand: $cmd"
      ;;
  esac
}

main "$@"
